#pragma code_page(65001)
#include <windows.h>

101 ICON "@CMAKE_SOURCE_DIR@/assets/branding/SoftLoafSpectral.ico"

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Yangming Feng and contributors\0"
   VALUE "FileDescription", "SoftLoaf Spectral\0"
   VALUE "FileVersion", "@SOFTLOAF_VERSION@\0"
   VALUE "InternalName", "SoftLoafSpectral\0"
   VALUE "LegalCopyright", "Copyright (C) 2026 Yangming Feng and contributors\0"
   VALUE "OriginalFilename", "SoftLoaf Spectral.exe\0"
   VALUE "ProductName", "SoftLoaf Spectral\0"
   VALUE "ProductVersion", "@SOFTLOAF_VERSION@\0"
  END
  BLOCK "080404b0"
  BEGIN
   VALUE "CompanyName", "Yangming Feng and contributors\0"
   VALUE "FileDescription", "面包光谱\0"
   VALUE "FileVersion", "@SOFTLOAF_VERSION@\0"
   VALUE "InternalName", "SoftLoafSpectral\0"
   VALUE "LegalCopyright", "Copyright (C) 2026 Yangming Feng and contributors\0"
   VALUE "OriginalFilename", "SoftLoaf Spectral.exe\0"
   VALUE "ProductName", "面包光谱\0"
   VALUE "ProductVersion", "@SOFTLOAF_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200, 0x0804, 1200
 END
END
